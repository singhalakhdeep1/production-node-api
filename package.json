{
  "name": "production-node-api",
  "version": "2.0.0",
  "description": "Production-ready Node.js Todo API: PM2 cluster, Postgres, Redis cache, JWT + API keys, GraphQL subscriptions, WebSockets, uploads, Prometheus/Loki/Tempo/CloudWatch/Datadog/PagerDuty",
  "main": "dist/src/server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "pm2-runtime start ecosystem.config.js --env production",
    "start:node": "node dist/src/server.js",
    "migrate": "node dist/src/db/migrate.js",
    "migrate:dev": "tsx src/db/migrate.ts",
    "test": "node --test tests/",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 reload ecosystem.config.js",
    "pm2:logs": "pm2 logs production-api",
    "pm2:monit": "pm2 monit"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@as-integrations/express4": "^1.1.2",
    "@aws-sdk/client-cloudwatch": "^3.750.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.750.0",
    "@graphql-tools/schema": "^10.0.23",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dd-trace": "^5.40.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "graphql": "^16.10.0",
    "graphql-subscriptions": "^3.0.0",
    "graphql-ws": "^6.0.4",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.13.3",
    "pm2": "^5.4.3",
    "prom-client": "^15.1.3",
    "redis": "^4.7.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0",
    "winston-transport": "^4.9.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.5",
    "@types/pg": "^8.11.11",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
