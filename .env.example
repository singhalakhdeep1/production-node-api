# --- Server ---
PORT=5000
NODE_ENV=development
LOG_LEVEL=info
LOG_DIR=logs
SERVICE_NAME=production-api
CORS_ORIGINS=http://localhost:3102
TRUST_PROXY=loopback

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/production_api
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_SSL=false
RUN_MIGRATIONS=true

# --- Redis (optional: without it the API uses the in-memory cache only) ---
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_TTL=3600
MEMORY_CACHE_MAX_ENTRIES=500
MEMORY_CACHE_TTL=30

# --- Security ---
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=10
ADMIN_EMAILS=admin@example.com
API_KEY_TTL_DAYS=365
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=20
RATE_LIMIT_BUCKET_CAPACITY=100
RATE_LIMIT_REFILL_RATE=1.0

# --- Resilience ---
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT=60000
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
LOAD_SHED_MAX_EVENT_LOOP_DELAY_MS=500
MEMORY_WARN_MB=450

# --- Compression ---
COMPRESSION_LEVEL=6
ENABLE_BROTLI=true

# --- Uploads ---
UPLOAD_PATH=./uploads
UPLOAD_MAX_FILE_SIZE=10485760

# --- PM2 ---
PM2_INSTANCES=max
PM2_MAX_MEMORY_RESTART=500M

# --- Monitoring (each sink is enabled by setting its variables) ---
LOKI_URL=
TEMPO_URL=
TEMPO_OTLP_URL=
CLOUDWATCH_ENABLED=false
CLOUDWATCH_REGION=us-east-1
CLOUDWATCH_NAMESPACE=NodeAPI
CLOUDWATCH_LOG_GROUP=node-api-logs
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DD_TRACE_ENABLED=false
DD_AGENT_HOST=localhost
DD_TRACE_AGENT_PORT=8126
DD_SERVICE=production-api
DD_ENV=development
PAGERDUTY_INTEGRATION_KEY=
PAGERDUTY_API_KEY=
LATENCY_ALERT_THRESHOLD_MS=2000
ERROR_RATE_ALERT_THRESHOLD_PCT=10
ERROR_RATE_ALERT_MIN_REQUESTS=20
ALERT_WEBHOOK_TOKEN=change-me
